# ─────────────────────────────────────────────────────────────
# Required — copy this file to .env.local and fill in values
# ALL of these must also be set in Vercel Dashboard → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# Supabase (get from Supabase Dashboard → Project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Services
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Firecrawl (web scraping for vault URL ingestion)
FIRECRAWL_API_KEY=fc-...

# HubSpot (ambassador applications & nominations)
HUBSPOT_PORTAL_ID=your-portal-id
HUBSPOT_APPLY_FORM_ID=your-apply-form-id
HUBSPOT_NOMINATE_FORM_ID=your-nominate-form-id
HUBSPOT_ACCESS_TOKEN=your-access-token
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=your-portal-id

# Zoom (webinar registration via HubSpot integration)
ZOOM_ACCOUNT_ID=your-account-id
ZOOM_CLIENT_ID=your-client-id
ZOOM_CLIENT_SECRET=your-client-secret

# Sentry (error tracking & session replays)
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# Site URL (used for canonical URLs & OG tags)
NEXT_PUBLIC_SITE_URL=https://nationalcheckinweek.com

# ─────────────────────────────────────────────────────────────
# Test / CI only — not needed in production
# ─────────────────────────────────────────────────────────────
PLAYWRIGHT_ADMIN_EMAIL=admin@example.com
PLAYWRIGHT_ADMIN_PASSWORD=your-test-password
